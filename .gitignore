# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Regenerated on every `bun run test:e2e`; review them locally, not in history.
app/e2e/screenshots/

# Local tooling caches
.impeccable/

# Generated by scripts/optimize_assets.py; source of truth stays in app/src/assets
app/src/assets-optimized/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# Office lock files, e.g. beside docs/raw/*.docx
~$*.doc*
~$*.xls*
~$*.ppt*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
